Panels:
  - Class: rviz_common/Displays
    Name: Displays

  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30

  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true

    - Class: rviz_default_plugins/Path
      Name: Camera Path
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Pose Style: None
      Color: 25; 255; 0
      Topic:
        Value: /nvblox_realtime_node/path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5

    - Class: rviz_default_plugins/Odometry
      Name: Camera Odometry
      Enabled: true
      Keep: 100
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Axes Length: 0.15
        Axes Radius: 0.01
      Topic:
        Value: /nvblox_realtime_node/odometry
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: odom

Window Geometry:
  Width: 1400
  Height: 900
