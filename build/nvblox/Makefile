	$(MAKE) $(MAKESILENT) -f _deps/ext_stdgpu-build/CMakeFiles/uninstall.dir/build.make _deps/ext_stdgpu-build/CMakeFiles/uninstall.dir/build
.PHONY : uninstall/fast

